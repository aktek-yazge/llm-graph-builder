# =============================================================================
# Agent Builder Environment Variables
# Copy this file to .env and update values for your environment
# =============================================================================

# Neo4j Ontology Database
NEO4J_ONTOLOGY_PASSWORD=ontology123

# PostgreSQL for MCP Gateway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mcp_gateway

# JWT Secret for MCP Gateway
JWT_SECRET_KEY=your-secret-key-change-in-production

# External service URLs (if running outside this compose)
NEO4J_DOCUMENTS_URL=bolt://neo4j-documents:7687
NEO4J_ONTOLOGY_URL=bolt://neo4j-ontology:7688
EMBEDDING_SERVER_URL=http://embedding-server:8003

# Celery
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
