# =============================================================================
# INFISICAL ENVIRONMENT VARIABLES
# =============================================================================
# Bu dosyayı kopyalayın: cp .env.example .env
# Ardından değerleri güncelleyin
# =============================================================================

# ============================================
# ENCRYPTION & AUTH (ZORUNLU)
# ============================================
# 32 karakter hex key: openssl rand -hex 16
ENCRYPTION_KEY=YOUR_32_CHAR_HEX_KEY_HERE

# Random base64 secret: openssl rand -base64 32
AUTH_SECRET=YOUR_RANDOM_AUTH_SECRET_HERE

# JWT lifetime (opsiyonel)
JWT_AUTH_LIFETIME=1d
JWT_REFRESH_LIFETIME=7d

# ============================================
# DATABASE
# ============================================
INFISICAL_DB_USER=infisical
INFISICAL_DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
INFISICAL_DB_NAME=infisical

# Full connection string (Infisical server kullanır)
DB_CONNECTION_URI=postgresql://infisical:CHANGE_THIS_SECURE_PASSWORD@infisical-db:5432/infisical

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://infisical-redis:6379

# ============================================
# SITE CONFIGURATION
# ============================================
# Public URL (dashboard ve API için)
SITE_URL=http://localhost:8085

# Invite-only mode (ilk kurulumdan sonra true yapılabilir)
INVITE_ONLY_SIGNUP=false

# ============================================
# EMAIL (Opsiyonel - davet ve şifre sıfırlama için)
# ============================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=secrets@example.com
# SMTP_FROM_NAME=Infisical

# ============================================
# TELEMETRY (Opsiyonel)
# ============================================
# Telemetry'yi kapatmak için
TELEMETRY_ENABLED=false
