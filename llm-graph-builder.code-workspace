{
  "folders": [
    {
      "name": "Root",
      "path": "."
    },
    {
      "name": "Backend",
      "path": "backend"
    },
    {
      "name": "Celery Worker",
      "path": "celery_worker"
    },
    {
      "name": "Frontend",
      "path": "frontend"
    },
    {
      "name": "MCP Neo4j Cypher",
      "path": "mcp-servers/mcp-neo4j-cypher"
    },
    {
      "name": "Agent Builder Backend",
      "path": "agent-builder/backend"
    },
    {
      "name": "Agent Builder Frontend",
      "path": "agent-builder/frontend"
    }
  ],
  "settings": {
    "python.terminal.activateEnvironment": true,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    },
    "python.analysis.extraPaths": [
      "/workspace/backend/src",
      "/workspace/celery_worker/src",
      "/workspace/mcp-servers/mcp-neo4j-cypher/src"
    ],
    "[python]": {
      "editor.defaultFormatter": "ms-python.black-formatter"
    }
  },
  "launch": {
    "configurations": [],
    "compounds": []
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.black-formatter"
    ]
  }
}