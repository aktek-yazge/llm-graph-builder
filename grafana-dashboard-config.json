{
  "dashboard": {
    "id": null,
    "title": "LLM Graph Builder - Log Observability",
    "tags": ["llm", "graph", "logs", "observability"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Log Seviyelerine Göre Dağılım (Son 1 Saat)",
        "type": "stat",
        "targets": [
          {
            "expr": "sum by (level) (count_over_time({service_name=\"llm-graph-builder\"} [1h]))",
            "legendFormat": "{{level}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": { "displayMode": "table", "showPoints": "auto" },
            "mappings": [],
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 10 },
                { "color": "red", "value": 50 }
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Hata Oranı (Son 24 Saat)",
        "type": "gauge",
        "targets": [
          {
            "expr": "sum(count_over_time({service_name=\"llm-graph-builder\"} |~ \"ERROR|❌\" [24h])) / sum(count_over_time({service_name=\"llm-graph-builder\"} [24h])) * 100"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "max": 100,
            "min": 0,
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 2 },
                { "color": "red", "value": 5 }
              ]
            },
            "unit": "percent"
          }
        }
      },
      {
        "id": 3,
        "title": "LLM Token Kullanımı (Son 6 Saat)",
        "type": "timeseries",
        "targets": [
          {
            "expr": "{service_name=\"llm-graph-builder\"} |~ \"🔢 LLM Token Kullanımı\" | regexp \"Total: (?P<tokens>\\\\d+)\" | unwrap tokens | rate(5m)",
            "legendFormat": "Token/dakika"
          }
        ],
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "axisLabel": "Token/dakika",
              "axisPlacement": "auto",
              "barAlignment": 0,
              "drawStyle": "line",
              "fillOpacity": 10,
              "gradientMode": "none",
              "hideFrom": { "legend": false, "tooltip": false, "vis": false },
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "pointSize": 5,
              "scaleDistribution": { "type": "linear" },
              "showPoints": "never",
              "spanNulls": true,
              "stacking": { "group": "A", "mode": "none" },
              "thresholdsStyle": { "mode": "off" }
            }
          }
        }
      },
      {
        "id": 4,
        "title": "İşlem Kategorileri (Emoji Analizi)",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum by (category) ((count_over_time({service_name=\"llm-graph-builder\"} |~ \"🚀\" [1h]) or vector(0)) + on() group_left() label_replace(vector(0), \"category\", \"LLM İşlemleri\", \"\", \"\")) + sum by (category) ((count_over_time({service_name=\"llm-graph-builder\"} |~ \"🔄\" [1h]) or vector(0)) + on() group_left() label_replace(vector(0), \"category\", \"İşlem Durumları\", \"\", \"\")) + sum by (category) ((count_over_time({service_name=\"llm-graph-builder\"} |~ \"✅\" [1h]) or vector(0)) + on() group_left() label_replace(vector(0), \"category\", \"Başarılı İşlemler\", \"\", \"\")) + sum by (category) ((count_over_time({service_name=\"llm-graph-builder\"} |~ \"❌\" [1h]) or vector(0)) + on() group_left() label_replace(vector(0), \"category\", \"Hatalı İşlemler\", \"\", \"\")) + sum by (category) ((count_over_time({service_name=\"llm-graph-builder\"} |~ \"📝|📋\" [1h]) or vector(0)) + on() group_left() label_replace(vector(0), \"category\", \"Veri İşleme\", \"\", \"\")) + sum by (category) ((count_over_time({service_name=\"llm-graph-builder\"} |~ \"🎯|🔗\" [1h]) or vector(0)) + on() group_left() label_replace(vector(0), \"category\", \"Graf İşlemleri\", \"\", \"\"))"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "hideFrom": { "legend": false, "tooltip": false, "vis": false }
            }
          }
        }
      },
      {
        "id": 5,
        "title": "LLM Çağrı Süreleri (Son 2 Saat)",
        "type": "timeseries",
        "targets": [
          {
            "expr": "{service_name=\"llm-graph-builder\"} |~ \"⏱️ LLM Çağrı süresi\" | regexp \"süresi: (?P<duration>\\\\d+\\\\.\\\\d+) saniye\" | unwrap duration",
            "legendFormat": "LLM Çağrı Süresi (saniye)"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "axisLabel": "Saniye",
              "axisPlacement": "auto",
              "barAlignment": 0,
              "drawStyle": "line",
              "fillOpacity": 10,
              "gradientMode": "none",
              "hideFrom": { "legend": false, "tooltip": false, "vis": false },
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "pointSize": 5,
              "scaleDistribution": { "type": "linear" },
              "showPoints": "auto",
              "spanNulls": true,
              "stacking": { "group": "A", "mode": "none" },
              "thresholdsStyle": { "mode": "off" }
            },
            "unit": "s"
          }
        }
      },
      {
        "id": 6,
        "title": "Son Hata Mesajları",
        "type": "logs",
        "targets": [
          {
            "expr": "{service_name=\"llm-graph-builder\"} |~ \"ERROR|❌|⚠️\"",
            "maxLines": 50
          }
        ],
        "gridPos": { "h": 12, "w": 24, "x": 0, "y": 24 },
        "options": {
          "showTime": true,
          "showLabels": false,
          "showCommonLabels": false,
          "wrapLogMessage": true,
          "prettifyLogMessage": false,
          "enableLogDetails": true,
          "dedupStrategy": "none",
          "sortOrder": "Descending"
        }
      },
      {
        "id": 7,
        "title": "Dosya İşleme İstatistikleri",
        "type": "table",
        "targets": [
          {
            "expr": "count by (filename) (count_over_time({service_name=\"llm-graph-builder\"} |~ \"Process file name:|🔄 Starting extract process\" | regexp \"name: (?P<filename>[^\\s]+)\" [24h]))",
            "legendFormat": "{{filename}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "custom": {
              "align": "auto",
              "displayMode": "auto"
            },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 5 },
                { "color": "red", "value": 10 }
              ]
            }
          }
        }
      },
      {
        "id": 8,
        "title": "Schema ve Veritabanı İşlemleri",
        "type": "timeseries",
        "targets": [
          {
            "expr": "count_over_time({service_name=\"llm-graph-builder\"} |~ \"🔄 Neo4j'den schema çekiliyor|DB'den çekilen|schema çekilemedi\" [5m])",
            "legendFormat": "Schema İşlemleri"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "axisLabel": "İşlem Sayısı",
              "axisPlacement": "auto",
              "barAlignment": 0,
              "drawStyle": "bars",
              "fillOpacity": 80,
              "gradientMode": "none",
              "hideFrom": { "legend": false, "tooltip": false, "vis": false },
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "pointSize": 5,
              "scaleDistribution": { "type": "linear" },
              "showPoints": "never",
              "spanNulls": false,
              "stacking": { "group": "A", "mode": "none" },
              "thresholdsStyle": { "mode": "off" }
            }
          }
        }
      },
      {
        "id": 9,
        "title": "Print vs Logger Mesajları",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(count_over_time({service_name=\"llm-graph-builder\"} |~ \"🚀|🔄|✅|❌|📝|📋|🎯|🔗|⚙️|🖼️|⚠️\" [1h]))",
            "legendFormat": "Print Mesajları (Emoji)"
          },
          {
            "expr": "sum(count_over_time({service_name=\"llm-graph-builder\"} | json | level != \"\" [1h]))",
            "legendFormat": "Logger Mesajları"
          }
        ],
        "gridPos": { "h": 6, "w": 24, "x": 0, "y": 44 },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": {
              "orientation": "horizontal",
              "displayMode": "table"
            },
            "thresholds": {
              "steps": [{ "color": "green", "value": null }]
            }
          }
        }
      }
    ],
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {},
    "templating": {
      "list": [
        {
          "current": {
            "selected": false,
            "text": "llm-graph-builder",
            "value": "llm-graph-builder"
          },
          "hide": 0,
          "includeAll": false,
          "multi": false,
          "name": "service",
          "options": [],
          "query": "label_values(service_name)",
          "refresh": 1,
          "regex": "",
          "skipUrlSync": false,
          "sort": 0,
          "type": "query"
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": "-- Grafana --",
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "refresh": "30s",
    "schemaVersion": 27,
    "version": 0,
    "links": []
  }
}

