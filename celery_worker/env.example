# ============================================
# CELERY WORKER ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in the values
# Usage: cp env.example .env

# ============================================
# WORKER CONFIGURATION
# ============================================
CELERY_POOL=threads
MAIN_CONCURRENCY=8
WRITER_CONCURRENCY=2
LOG_LEVEL=info
ENV=development

# ============================================
# CELERY / MESSAGE BROKER
# ============================================
CELERY_BROKER_URL=amqp://user:password@your-rabbitmq-host:5672//
CELERY_RESULT_BACKEND=db+postgresql://user:password@your-postgres-host:5432/your_database

# ============================================
# DATABASE (PostgreSQL)
# ============================================
QUEUE_DB_URL=postgresql://user:password@your-postgres-host:5432/your_database

# ============================================
# NEO4J CONNECTION
# ============================================
NEO4J_URI=bolt://your-neo4j-host:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# Neo4j Timeout Settings (seconds)
NEO4J_CONNECTION_TIMEOUT=60
NEO4J_READ_TIMEOUT=300
NEO4J_WRITE_TIMEOUT=300
NEO4J_MAX_CONNECTION_LIFETIME=300
NEO4J_MAX_CONNECTION_POOL_SIZE=100
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=60

# Neo4j Retry Settings
NEO4J_MAX_RETRIES=5
NEO4J_RETRY_DELAY=3

# Neo4j User Agent (optional)
# ENABLE_USER_AGENT=false
# NEO4J_USER_AGENT=your-app-name

# ============================================
# AWS / S3
# ============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
S3_BUCKET_NAME=
S3_BACKUP_BUCKET=
USE_S3_ONLY=false

# ============================================
# API KEYS
# ============================================
OPENAI_API_KEY=
GEMINI_API_KEY=

# ============================================
# EMBEDDING MODELS
# ============================================
EMBEDDING_MODEL=openai
HUGGINGFACE_MODEL_NAME=BAAI/bge-m3
IS_EMBEDDING=TRUE
RAGAS_EMBEDDING_MODEL=openai
# BEDROCK_EMBEDDING_MODEL=

# ============================================
# OUTPUT DIRECTORIES
# ============================================
OUTPUT_DIR=output
OUTPUT_IMAGES_DIR=output/images
OUTPUT_VOLUME=output_data

# ============================================
# PROCESSING SETTINGS
# ============================================
CHUNK_CREATION_BATCH_SIZE=20
V2_BATCH_SIZE=100
V2_UPLOAD_WAIT_TIME=10
LLM_EXTRACTION_MAX_RETRIES=3
LLM_EXTRACTION_RETRY_DELAY=5
CLEANUP_TEMP_FILES=false
GRAPH_CLEANUP_MODEL=openai_gpt_4o

# ============================================
# KNN / SIMILARITY SETTINGS
# ============================================
KNN_MIN_SCORE=0.94
DUPLICATE_SCORE_VALUE=0.97
DUPLICATE_TEXT_DISTANCE=3

# ============================================
# ENTITY MATCHING - CUSTOMER
# ============================================
CUSTOMER_EDIT_DISTANCE=1
CUSTOMER_JARO_SIMILARITY=0.95
CUSTOMER_MIN_SUBSTRING_LENGTH=6

# ============================================
# ENTITY MATCHING - INSURANCE COMPANY
# ============================================
INSURANCE_COMPANY_EDIT_DISTANCE=2
INSURANCE_COMPANY_JARO_SIMILARITY=0.90
INSURANCE_COMPANY_MIN_SUBSTRING_LENGTH=5

# ============================================
# ENTITY MATCHING - COVERAGE TYPE
# ============================================
COVERAGE_TYPE_EDIT_DISTANCE=2
COVERAGE_TYPE_JARO_SIMILARITY=0.95
COVERAGE_TYPE_MIN_SUBSTRING_LENGTH=5
COVERAGE_TYPE_MIN_COMMON_WORDS=3

# ============================================
# OBSERVABILITY (OpenTelemetry)
# ============================================
OTEL_SERVICE_NAME=llm-graph-builder
OTEL_ENVIRONMENT=development

# ============================================
# MISC
# ============================================
BASE_URL=http://localhost:8000
FORCE_CPU=false
# YOUTUBE_TRANSCRIPT_PROXY=

# ============================================
# MONITORING (Flower)
# ============================================
FLOWER_AUTH=admin:admin
