# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                     CELERY WORKER - ENVIRONMENT VARIABLES                    ║
# ║                                                                              ║
# ║  KULLANIM:                                                                   ║
# ║    cp .env.example .env.{tenant}                                             ║
# ║    Örnek: cp .env.example .env.akkok-sicil                                   ║
# ║                                                                              ║
# ║  INFISICAL PROJE YAPISI:                                                     ║
# ║    celery/{tenant}/development                                               ║
# ║    celery/{tenant}/staging                                                   ║
# ║    celery/{tenant}/production                                                ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ══════════════════════════════════════════════════════════════════════════════
# 🔴 ZORUNLU - TEMEL BAĞLANTILAR
# ══════════════════════════════════════════════════════════════════════════════

# --- CELERY / MESSAGE BROKER ---
CELERY_BROKER_URL=amqp://rabbitmq:password@rabbitmq:5672//
CELERY_RESULT_BACKEND=db+postgresql://postgres:password@postgres:5432/llm_graph_builder

# --- DATABASE (PostgreSQL) ---
POSTGRES_URL=postgresql://postgres:password@postgres:5432/llm_graph_builder

# --- REDIS ---
REDIS_URL=redis://redis:6379
REDIS_SEMANTIC_URL=redis://redis:6379

# --- NEO4J ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j_password
NEO4J_DATABASE=neo4j

# ══════════════════════════════════════════════════════════════════════════════
# 🔴 ZORUNLU - AWS S3 (PDF/Image Storage)
# ══════════════════════════════════════════════════════════════════════════════

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
S3_BUCKET_NAME=your-bucket-name

# ══════════════════════════════════════════════════════════════════════════════
# 🔴 ZORUNLU - LLM API KEYS
# ══════════════════════════════════════════════════════════════════════════════

# OpenAI API Key
OPENAI_API_KEY=sk-xxx

# Gemini API Key (opsiyonel, OpenAI yoksa kullanılır)
GEMINI_API_KEY=

# LLM Model Configurations (format: model_name,api_key veya model_name,endpoint,api_key)
LLM_MODEL_CONFIG_OPENAI_GPT_4O=gpt-4o,sk-xxx
LLM_MODEL_CONFIG_OPENAI_GPT_4O_MINI=gpt-4o-mini,sk-xxx

# ══════════════════════════════════════════════════════════════════════════════
# 🟡 OPSİYONEL - OBSERVABILITY (Langfuse)
# ══════════════════════════════════════════════════════════════════════════════

LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ══════════════════════════════════════════════════════════════════════════════
# 🟡 OPSİYONEL - WORKER CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════

# Worker ayarları
LOG_LEVEL=info
ENV=development
CELERY_POOL=prefork
MAIN_CONCURRENCY=8
WRITER_CONCURRENCY=2

# Output dizinleri
OUTPUT_DIR=output
OUTPUT_IMAGES_DIR=output/images

# ══════════════════════════════════════════════════════════════════════════════
# 🟡 OPSİYONEL - PROCESSING AYARLARI
# ══════════════════════════════════════════════════════════════════════════════

# Chunk ve batch ayarları
CHUNK_CREATION_BATCH_SIZE=20
V2_BATCH_SIZE=100
V2_UPLOAD_WAIT_TIME=10

# Retry ayarları
LLM_EXTRACTION_MAX_RETRIES=3
LLM_EXTRACTION_RETRY_DELAY=5

# S3 kullanım modu (true = sadece S3, false = lokal + S3)
USE_S3_ONLY=false

# Temp dosya temizliği
CLEANUP_TEMP_FILES=false

# ══════════════════════════════════════════════════════════════════════════════
# 🟡 OPSİYONEL - ENTITY RESOLUTION
# ══════════════════════════════════════════════════════════════════════════════

ENTITY_RESOLUTION_ENABLED=true
ENTITY_RESOLUTION_THRESHOLD=0.85
ENTITY_RESOLUTION_MIN_CLUSTER_SIZE=2

# KNN / Similarity
KNN_MIN_SCORE=0.94
DUPLICATE_SCORE_VALUE=0.97
DUPLICATE_TEXT_DISTANCE=3

# ══════════════════════════════════════════════════════════════════════════════
# 🟡 OPSİYONEL - EMBEDDING AYARLARI
# ══════════════════════════════════════════════════════════════════════════════

EMBEDDING_MODEL=openai
HUGGINGFACE_MODEL_NAME=BAAI/bge-m3
IS_EMBEDDING=TRUE

# ══════════════════════════════════════════════════════════════════════════════
# 🟡 OPSİYONEL - NEO4J TUNING
# ══════════════════════════════════════════════════════════════════════════════

NEO4J_CONNECTION_TIMEOUT=60
NEO4J_READ_TIMEOUT=300
NEO4J_WRITE_TIMEOUT=300
NEO4J_MAX_CONNECTION_LIFETIME=300
NEO4J_MAX_CONNECTION_POOL_SIZE=100
NEO4J_CONNECTION_ACQUISITION_TIMEOUT=60
NEO4J_MAX_RETRIES=5
NEO4J_RETRY_DELAY=3

# ══════════════════════════════════════════════════════════════════════════════
# 🟡 OPSİYONEL - MINIO (Resource Image Extraction)
# ══════════════════════════════════════════════════════════════════════════════

MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
AGENT_BUILDER_URL=http://localhost:8001

# ══════════════════════════════════════════════════════════════════════════════
# 🟡 OPSİYONEL - MONITORING
# ══════════════════════════════════════════════════════════════════════════════

FLOWER_AUTH=admin:admin
OTEL_SERVICE_NAME=celery-worker
OTEL_ENVIRONMENT=development
