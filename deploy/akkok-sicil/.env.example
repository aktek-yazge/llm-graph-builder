# =============================================================================
# AKKOK-SİCİL - Staging Environment Variables
# =============================================================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
#   cp .env.example .env
#
# ÖN KOŞUL:
#   Infrastructure stack çalışıyor olmalı:
#   cd ../infrastructure && docker compose -p infrastructure up -d
#
# KULLANIM:
#   # Manuel
#   docker compose -p akkok-sicil -f docker-compose.staging.yml --env-file .env up -d
#
#   # Infisical ile (önerilen)
#   infisical run --env=staging --path=/tenants/akkok-sicil -- docker compose up -d
# =============================================================================

# =============================================================================
# 🔴 ZORUNLU - DOMAIN & ROUTING
# =============================================================================

TENANT_DOMAIN=akkok-sicil.yazge.aktekbilisim.com

# =============================================================================
# 🔴 ZORUNLU - DATABASE PASSWORDS
# =============================================================================

POSTGRES_PASSWORD=
POSTGRES_USER=postgres
POSTGRES_DB=llm_graph_builder

NEO4J_PASSWORD=
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j

# RabbitMQ (infrastructure stack'teki ile aynı olmalı)
RABBITMQ_USER=rabbitmq
RABBITMQ_PASSWORD=

# =============================================================================
# 🔴 ZORUNLU - LLM API KEYS
# =============================================================================

OPENAI_API_KEY=sk-xxx
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# LLM Model Configurations (format: model_name,api_key)
LLM_MODEL_CONFIG_openai_gpt_4o_mini=gpt-4o-mini,sk-xxx
LLM_MODEL_CONFIG_openai_gpt_4o=gpt-4o,sk-xxx
LLM_MODEL_CONFIG_gemini_2.0_flash=gemini-2.0-flash-001,AIzaxxx

# =============================================================================
# 🔴 ZORUNLU - AWS S3 (PDF/Image Storage)
# =============================================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
S3_BUCKET_NAME=akkok-ticaret-sicil

# =============================================================================
# 🔴 ZORUNLU - AUTHENTICATION
# =============================================================================

JWT_SECRET_KEY=
JWT_EXPIRATION_HOURS=168
ADMIN_EMAIL=admin@akkok.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# =============================================================================
# 🟡 OPSİYONEL - OBSERVABILITY
# =============================================================================

# Langfuse (LLM Tracing)
LANGFUSE_ENABLED=true
LANGFUSE_HOST=https://langfuse.yazge.aktekbilisim.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# OpenTelemetry (Traces & Logs)
# Aynı sunucuda: http://alloy:4317
# Ayrı sunucuda: https://otel.yazge.aktekbilisim.com:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317
OTEL_ENVIRONMENT=staging

# =============================================================================
# 🟡 OPSİYONEL - REACT AGENT
# =============================================================================

USE_REACT_AGENT=true
REACT_MODEL=gpt-4o
REACT_TOOL_MODE=cypher

# =============================================================================
# 🟡 OPSİYONEL - PROCESSING SETTINGS
# =============================================================================

EMBEDDING_MODEL=openai
V2_BATCH_SIZE=10
LOG_LEVEL=info

# =============================================================================
# 🟡 OPSİYONEL - UI PASSWORDS
# =============================================================================

PGADMIN_EMAIL=admin@akkok.com
PGADMIN_PASSWORD=

# =============================================================================
# 🟡 OPSİYONEL - MONITORING
# =============================================================================

FLOWER_AUTH=admin:
