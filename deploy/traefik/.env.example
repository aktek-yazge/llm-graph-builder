# =============================================================================
# TRAEFIK - Environment Variables
# =============================================================================

# Base domain
BASE_DOMAIN=yazge.aktekbilisim.com

# Dashboard authentication (htpasswd format)
# Generate: htpasswd -nb admin <password>
# Escape $ with $$ in docker-compose
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$xxx

# Let's Encrypt email
ACME_EMAIL=admin@aktekbilisim.com
