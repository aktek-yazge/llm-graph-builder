# =============================================================================
# INFRASTRUCTURE - Shared Services Environment Variables
# =============================================================================
# Bu dosyayı .env olarak kopyalayın:
#   cp .env.example .env
#
# VEYA Infisical kullanın:
#   infisical run --env=staging --path=/infrastructure -- docker compose up -d
# =============================================================================

# =============================================================================
# 🔴 ZORUNLU - BASE DOMAIN
# =============================================================================

BASE_DOMAIN=yazge.aktekbilisim.com

# =============================================================================
# 🔴 ZORUNLU - RABBITMQ
# =============================================================================

RABBITMQ_USER=rabbitmq
RABBITMQ_PASSWORD=

# =============================================================================
# 🔴 ZORUNLU - HARİCİ SERVİS ENDPOINT'LERİ
# =============================================================================
# Alloy bu endpoint'lere telemetri gönderir

# Loki - Log aggregation (harici sunucu)
LOKI_URL=https://loki.yazge.aktekbilisim.com

# Tempo - Distributed tracing (harici sunucu)
TEMPO_URL=https://tempo.yazge.aktekbilisim.com:4317

# Prometheus Remote Write (opsiyonel - metrics için)
# Grafana Cloud veya self-hosted Mimir/Prometheus
PROMETHEUS_REMOTE_WRITE_URL=
